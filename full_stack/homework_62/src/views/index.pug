extends layout

block content
  h1 Get root route
  p Навчальний Express-сервер з шаблонізаторами PUG та EJS.
  ul
    li: a(href="/users") Список користувачів (PUG)
    li: a(href="/articles") Список статей (EJS)
    li: a(href="/session") Інформація про сесію (JSON)
  p Візитів у поточній сесії: #{visits}
