PORT=3000
# Рядок підключення до MongoDB Atlas (Database -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=hillel
MONGODB_DB=hillel_hw
# Статичний токен для Authorization: Bearer <token>
API_TOKEN=secret-token
SESSION_SECRET=change-me
