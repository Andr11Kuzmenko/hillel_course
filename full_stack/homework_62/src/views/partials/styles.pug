style.
  body { font-family: system-ui, sans-serif; margin: 0; background: #f6f7f9; color: #1f2328; }
  header { background: #24292f; padding: 12px 24px; }
  nav a { color: #fff; margin-right: 16px; text-decoration: none; }
  main { max-width: 860px; margin: 24px auto; padding: 0 16px; }
  table { width: 100%; border-collapse: collapse; background: #fff; }
  th, td { padding: 8px 12px; border-bottom: 1px solid #d0d7de; text-align: left; }
  .card { background: #fff; border: 1px solid #d0d7de; border-radius: 8px; padding: 16px; margin-bottom: 12px; }
  .tag { display: inline-block; background: #ddf4ff; color: #0969da; border-radius: 12px; padding: 2px 8px; margin-right: 4px; font-size: 12px; }
  footer { text-align: center; color: #57606a; font-size: 12px; padding: 24px; }
