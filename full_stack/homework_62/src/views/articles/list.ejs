<%- include('../partials/header', { title }) %>
<h1>Articles</h1>
<% if (articles.length) { %>
  <% articles.forEach((article) => { %>
    <div class="card">
      <h2><a href="/articles/<%= article.id %>"><%= article.title %></a></h2>
      <p class="meta"><%= article.author %> · <%= article.createdAt %></p>
      <p>
        <% article.tags.forEach((tag) => { %><span class="tag"><%= tag %></span><% }) %>
      </p>
    </div>
  <% }) %>
<% } else { %>
  <p>Статей немає.</p>
<% } %>
<%- include('../partials/footer') %>
